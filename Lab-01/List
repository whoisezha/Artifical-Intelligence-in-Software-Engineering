def count_matching(lst):
    count = 0
    for word in lst:
        if len(word) >= 2 and word[0] == word[-1]:
            count += 1
    return count

sample_list = ['abc', 'xyz', 'aba', '1221']
result = count_matching(sample_list)
print("Result:", result)
